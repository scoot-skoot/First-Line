{
  "name": "steadyline-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "smoke": "tsx scripts/smoke/all.ts",
    "smoke:gemini": "tsx scripts/smoke/gemini.ts",
    "smoke:tts": "tsx scripts/smoke/tts.ts",
    "smoke:stt": "tsx scripts/smoke/stt.ts",
    "smoke:backboard": "tsx scripts/smoke/backboard.ts",
    "smoke:db": "tsx scripts/smoke/db.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/distress.test.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.70.0",
    "@google/genai": "^2.3.0",
    "backboard-sdk": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.0.2",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
