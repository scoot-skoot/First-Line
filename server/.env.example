PORT=3001

# Provider switches (defaults work with no API keys)
AI_PROVIDER=mock
VOICE_PROVIDER=mock
MEMORY_PROVIDER=none
REPO_PROVIDER=memory

# Gemini (AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SCORER_MODEL=gemini-3.8-flash

# ElevenLabs (VOICE_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Full-duplex voice (ElevenLabs Agents) — see docs/DUPLEX.md
# Default CALL_MODE=ptt leaves the push-to-talk path untouched.
CALL_MODE=ptt
# CALL_MODE=duplex
# ELEVENLABS_AGENT_ID=agent_xxxxxxxx
# DUPLEX_LLM_MODE=overrides   # recommended for live demo (no public URL)
# DUPLEX_LLM_MODE=custom      # Gemini via OpenAI-compat endpoint (needs ngrok/cloudflared)
# DUPLEX_CONNECTION=webrtc    # or websocket (signed URL)

# Backboard (MEMORY_PROVIDER=backboard)
# When backboard is slow or unset, session-history / seeded Ray memories are used.
BACKBOARD_API_KEY=

# Postgres / Tiger Cloud (REPO_PROVIDER=postgres)
# Tiger Cloud is Postgres + TimescaleDB; optional migration: db/migrations/002_tiger_timescale.sql
DATABASE_URL=postgres://user:password@host:5432/firstline?sslmode=require
